{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sub Sync",
  "version": "0.1.0",
  "identifier": "dev.subsync.editor",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "label": "main", "title": "Sub Sync", "width": 1600, "height": 950,
      "minWidth": 1100, "minHeight": 700, "backgroundColor": "#14161a"
    }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost http://127.0.0.1:1420 ws://127.0.0.1:1420; media-src 'self' media: http://media.localhost https://media.localhost blob:"
    }
  },
  "bundle": {
    "active": true,
    "useLocalToolsDir": true,
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "targets": ["nsis"],
    "fileAssociations": [{ "ext": ["subsync"], "name": "SubSync.Project", "description": "Sub Sync 프로젝트", "role": "Editor", "mimeType": "application/json" }],
    "resources": { "../backend/transcribe.py": "backend/transcribe.py", "../backend/sentence_boundary.py": "backend/sentence_boundary.py", "../backend/requirements.txt": "backend/requirements.txt" },
    "windows": { "webviewInstallMode": { "type": "downloadBootstrapper" } }
  }
}
